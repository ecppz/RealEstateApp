@model AdminHomeViewModel
@{
    ViewData["Title"] = "Dashboard Admin";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid animate__animated animate__fadeIn">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-extrabold text-dark-blue mb-1">Panel de Control</h2>
            <p class="text-muted">Resumen general del estado de la plataforma</p>
        </div>
        <div class="bg-white p-2 rounded-4 shadow-sm border">
            <span class="px-3 fw-bold text-primary small"><i class="bi bi-calendar3 me-2"></i> @DateTime.Now.ToString("dd MMM, yyyy")</span>
        </div>
    </div>

    <h5 class="text-dark-blue fw-bold mb-4 ms-2">Gestión de Inmuebles</h5>
    <div class="row g-4 mb-5">
        <div class="col-md-6 col-xl-3">
            <div class="card admin-stat-card border-0">
                <div class="card-body p-4 text-center">
                    <div class="stat-icon-box bg-gradient-blue mx-auto">
                        <i class="bi bi-house-check"></i>
                    </div>
                    <span class="stat-label">Disponibles</span>
                    <div class="stat-number">@Model.AvailableProperties</div>
                    <div class="progress mt-3" style="height: 6px; border-radius: 10px;">
                        <div class="progress-bar bg-primary" style="width: 100%"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card admin-stat-card border-0">
                <div class="card-body p-4 text-center">
                    <div class="stat-icon-box bg-gradient-green mx-auto">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <span class="stat-label">Vendidas</span>
                    <div class="stat-number">@Model.SoldProperties</div>
                    <div class="progress mt-3" style="height: 6px; border-radius: 10px;">
                        <div class="progress-bar bg-success" style="width: 100%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <h5 class="text-dark-blue fw-bold mb-4 ms-2">Comunidad y Equipo</h5>
    <div class="row g-4">
        <div class="col-md-6 col-xl-4">
            <div class="card admin-stat-card border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="stat-icon-box bg-gradient-purple mb-0 me-3">
                            <i class="bi bi-people"></i>
                        </div>
                        <div>
                            <span class="stat-label mb-0">Agentes Activos</span>
                            <div class="stat-number mb-0">@Model.ActiveAgents</div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <span class="inactive-badge">Inactivos: @Model.InactiveAgents</span>
                        <a href="#" class="btn btn-link btn-sm text-decoration-none">Gestionar</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card admin-stat-card border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="stat-icon-box bg-gradient-orange mb-0 me-3">
                            <i class="bi bi-person-badge"></i>
                        </div>
                        <div>
                            <span class="stat-label mb-0">Clientes Totales</span>
                            <div class="stat-number mb-0">@Model.ActiveClients</div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <span class="inactive-badge">Inactivos: @Model.InactiveClients</span>
                        <a href="#" class="btn btn-link btn-sm text-decoration-none">Ver lista</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card admin-stat-card border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="stat-icon-box bg-dark mb-0 me-3 text-white">
                            <i class="bi bi-code-slash"></i>
                        </div>
                        <div>
                            <span class="stat-label mb-0">Desarrolladores</span>
                            <div class="stat-number mb-0">@Model.ActiveDevelopers</div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <span class="inactive-badge">Inactivos: @Model.InactiveDevelopers</span>
                        <a href="#" class="btn btn-link btn-sm text-decoration-none">Soporte</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>