@using Domain.Common.Enums
@model List<PropertyViewModel>

@{
    ViewData["Title"] = "Mis Propiedades";
    Layout = "_LayoutAgent";
}

<div class="container-fluid animate__animated animate__fadeIn">
    @* --- HEADER DE SECCIÓN --- *@
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">Mantenimiento de Propiedades</h2>
            <p class="text-muted mb-0">Gestiona y actualiza tu catálogo de inmuebles disponibles.</p>
        </div>
        <a asp-action="CreateProperty" class="btn btn-primary px-4 py-2 shadow-sm d-flex align-items-center gap-2" style="border-radius: 10px;">
            <i class="bi bi-plus-lg fs-5"></i>
            <span class="fw-bold">Nueva Propiedad</span>
        </a>
    </div>

    @* --- ALERTAS --- *@
    @if (TempData["ErrorMessage"] != null || TempData["SuccessMessage"] != null)
    {
        <div class="row mb-4">
            <div class="col-12">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center animate__animated animate__shakeX" role="alert">
                        <i class="bi bi-exclamation-octagon-fill me-2"></i>
                        <div>@TempData["ErrorMessage"]</div>
                    </div>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success border-0 shadow-sm d-flex align-items-center animate__animated animate__fadeInUp" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        <div>@TempData["SuccessMessage"]</div>
                    </div>
                }
            </div>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var property in Model)
            {
                <div class="col-xl-4 col-lg-6 col-md-6">
                    <div class="card h-100 border-0 shadow-sm overflow-hidden animate__animated animate__zoomIn" style="border-radius: 20px; transition: transform 0.3s ease;">
                        
                        @* 1. ÁREA VISUAL (Carousel) *@
                        <div class="position-relative">
                            @if (property.Images != null && property.Images.Any())
                            {
                                <div id="carousel-@property.Id" class="carousel slide" data-bs-ride="carousel">
                                    <div class="carousel-inner" style="height: 240px;">
                                        @for (int i = 0; i < property.Images.Count; i++)
                                        {
                                            var img = property.Images.ElementAt(i);
                                            <div class="carousel-item @(i == 0 ? "active" : "") h-100">
                                                <img src="@Url.Content("~/" + img.ImageUrl)" class="d-block w-100 h-100" style="object-fit: cover;" alt="Propiedad" />
                                            </div>
                                        }
                                    </div>
                                    @if (property.Images.Count > 1)
                                    {
                                        <button class="carousel-control-prev" type="button" data-bs-target="#carousel-@property.Id" data-bs-slide="prev">
                                            <span class="carousel-control-prev-icon" aria-hidden="true" style="width: 20px;"></span>
                                        </button>
                                        <button class="carousel-control-next" type="button" data-bs-target="#carousel-@property.Id" data-bs-slide="next">
                                            <span class="carousel-control-next-icon" aria-hidden="true" style="width: 20px;"></span>
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="bg-light d-flex flex-column align-items-center justify-content-center text-muted" style="height: 240px;">
                                    <i class="bi bi-image-fill display-4 opacity-25"></i>
                                    <span class="small mt-2">Sin imágenes disponibles</span>
                                </div>
                            }

                            @* Badges flotantes *@
                            <div class="position-absolute top-0 end-0 m-3 d-flex flex-column gap-2 align-items-end">
                                <span class="badge bg-white text-dark shadow-sm py-2 px-3 border-0" style="border-radius: 8px; font-size: 0.75rem;">
                                    <i class="bi bi-upc-scan me-1 text-primary"></i> @property.Code
                                </span>
                                @if (property.Status == PropertyStatus.Available)
                                {
                                    <span class="badge bg-success shadow-sm py-2 px-3 border-0" style="border-radius: 8px; font-size: 0.75rem;">Disponible</span>
                                }
                                else if (property.Status == PropertyStatus.Sold)
                                {
                                    <span class="badge bg-danger shadow-sm py-2 px-3 border-0" style="border-radius: 8px; font-size: 0.75rem;">Vendida</span>
                                }
                            </div>

                            <div class="position-absolute bottom-0 start-0 m-3">
                                <span class="badge bg-primary py-2 px-3 shadow" style="border-radius: 8px;">
                                    @property.SaleType?.Name
                                </span>
                            </div>
                        </div>

                        @* 2. CUERPO DE LA TARJETA *@
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="fw-bold text-dark mb-1">@property.PropertyType?.Name</h5>
                                    <p class="text-muted small mb-0"><i class="bi bi-geo-alt-fill me-1"></i> República Dominicana</p>
                                </div>
                                <div class="text-end">
                                    <h5 class="text-primary fw-bold mb-0">@property.Price.ToString("C0")</h5>
                                    <small class="text-muted" style="font-size: 0.7rem;">Precio de Venta</small>
                                </div>
                            </div>

                            <p class="text-secondary small mb-4" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.5;">
                                @property.Description
                            </p>

                            @* Iconos de Especificaciones *@
                            <div class="row g-2 text-center mb-4">
                                <div class="col-4">
                                    <div class="p-2 bg-light rounded-3">
                                        <i class="bi bi-door-open d-block text-primary mb-1"></i>
                                        <span class="fw-bold small">@property.Bedrooms Hab.</span>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="p-2 bg-light rounded-3">
                                        <i class="bi bi-droplet d-block text-info mb-1"></i>
                                        <span class="fw-bold small">@property.Bathrooms Baños</span>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="p-2 bg-light rounded-3">
                                        <i class="bi bi-fullscreen d-block text-success mb-1"></i>
                                        <span class="fw-bold small">@property.SizeInMeters m²</span>
                                    </div>
                                </div>
                            </div>

                            @* Mejoras *@
                            <div class="mb-4">
                                <h6 class="small fw-bold text-muted text-uppercase mb-2" style="letter-spacing: 0.5px;">Mejoras:</h6>
                                <div class="d-flex flex-wrap gap-1">
                                    @if (property.Improvements != null && property.Improvements.Any())
                                    {
                                        foreach (var imp in property.Improvements)
                                        {
                                            <span class="badge bg-light text-dark border fw-normal" style="font-size: 0.7rem;">@imp.Improvement?.Name</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small italic">Sin mejoras registradas</span>
                                    }
                                </div>
                            </div>
                        </div>

                        @* 3. ACCIONES (Footer) *@
                        <div class="card-footer bg-white border-top-0 p-4 pt-0">
                            <div class="row g-2">
                                <div class="col-6">
                                    <a asp-action="EditProperty" asp-route-id="@property.Id" class="btn btn-outline-warning w-100 d-flex align-items-center justify-content-center gap-2 py-2" style="border-radius: 10px;">
                                        <i class="bi bi-pencil-square"></i> <span class="small fw-bold">Editar</span>
                                    </a>
                                </div>
                                <div class="col-6">
                                    <a asp-action="DeleteProperty" asp-route-id="@property.Id" class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-2 py-2" style="border-radius: 10px;">
                                        <i class="bi bi-trash"></i> <span class="small fw-bold">Eliminar</span>
                                    </a>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row mt-5">
            <div class="col-12 text-center py-5">
                <div class="bg-white d-inline-block p-5 shadow-sm" style="border-radius: 30px;">
                    <i class="bi bi-house-add display-1 text-muted opacity-25"></i>
                    <h3 class="mt-4 fw-bold text-secondary">No hay propiedades registradas</h3>
                    <p class="text-muted">Comienza a construir tu portafolio agregando tu primera propiedad.</p>
                    <a asp-action="CreateProperty" class="btn btn-primary px-4 mt-3">Crear mi primera propiedad</a>
                </div>
            </div>
        </div>
    }
</div>