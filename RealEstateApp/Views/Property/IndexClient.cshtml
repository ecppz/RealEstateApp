@using Domain.Common.Enums
@model IEnumerable<PropertyDto>
@{
    Layout = "_LayoutCustomer";
    ViewData["Title"] = "Explorar Propiedades";

    var chatProperties = Model.Select(property => new
    {
        id = property.Id,
        code = property.Code,
        price = property.Price,
        rooms = property.Bedrooms,
        size = property.SizeInMeters,
        type = property.PropertyType?.Name ?? string.Empty
    });

    var serializedChatProperties = System.Text.Json.JsonSerializer.Serialize(chatProperties);
}

<div class="container-fluid animate__animated animate__fadeIn">
    
    <div class="view-header d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-building-search me-2 text-primary"></i>Catálogo Inmobiliario</h2>
            <p class="text-muted mb-0">Explora @Model.Count() opciones disponibles para ti</p>
        </div>
        <div class="text-end">
            <span class="badge bg-white text-dark shadow-sm py-2 px-3 border-0" style="border-radius: 10px;">
                <i class="bi bi-clock-history me-1 text-primary"></i> Actualizado hoy
            </span>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-7 col-lg-6">
            <div class="property-list-container">
                <div class="table-responsive">
                    <table class="table custom-table align-middle">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Inversión</th>
                                <th>Estado</th>
                                <th class="text-center">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var property in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">#@property.Code</td>
                                    <td>
                                        <div class="fw-bold text-dark">@property.Price.ToString("C0")</div>
                                        <small class="text-muted">RD$ / @property.SizeInMeters m²</small>
                                    </td>
                                    <td>
                                        <span class="badge @(property.Status == PropertyStatus.Available ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning") px-3 py-2" style="border-radius: 8px;">
                                            @property.Status
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <a asp-controller="Property" asp-action="PropertyDetailClient" asp-route-propertyId="@property.Id"
                                               class="btn btn-sm btn-dark px-3" style="border-radius: 10px;">
                                            Ver <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-xl-5 col-lg-6">
            <div class="card ai-chat-card sticky-top" style="top: 2rem; z-index: 100;">
                <div class="card-header ai-chat-header border-0">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 p-2 rounded-circle me-3">
                            <i class="bi bi-robot text-primary fs-4"></i>
                        </div>
                        <div>
                            <h5 class="text-white mb-0">Asistente Inteligente</h5>
                            <small class="text-info">PropTech IA • Online</small>
                        </div>
                    </div>
                </div>

                <div class="ai-chat-body">
                    <div class="row g-2 mb-3 bg-white p-3 rounded-4 shadow-sm">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Presupuesto máx.</label>
                            <input id="chatBudget" type="number" class="form-control pref-input" placeholder="Ej. 200000" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Habitaciones</label>
                            <input id="chatRooms" type="number" class="form-control pref-input" placeholder="Min. 1" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Tipo</label>
                            <input id="chatType" type="text" class="form-control pref-input" placeholder="Apartamento..." />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Área (m²)</label>
                            <input id="chatSize" type="number" class="form-control pref-input" placeholder="Ej. 80" />
                        </div>
                    </div>

                    <div id="chatMessages" class="ai-chat-messages mb-3">
                        <div class="ai-msg ai-msg-bot">
                            👋 ¡Hola! Soy tu asesor personal. Si me dices tu presupuesto o qué tipo de hogar buscas, encontraré la mejor opción para ti.
                        </div>
                    </div>

                    <div id="typingIndicator" class="text-muted small mb-2 d-none">
                        <span class="spinner-grow spinner-grow-sm text-primary me-1"></span> IA analizando propiedades...
                    </div>

                    <div class="chat-input-group d-flex align-items-center">
                        <input id="chatInput" type="text" class="form-control px-3" placeholder="Pregúntame algo..." />
                        <button id="chatSend" class="btn btn-primary rounded-circle p-2 ms-2" style="width: 45px; height: 45px;">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (() => {
        const properties = @Html.Raw(serializedChatProperties);
        const chatMessages = document.getElementById("chatMessages");
        const chatInput = document.getElementById("chatInput");
        const chatSend = document.getElementById("chatSend");
        const typingIndicator = document.getElementById("typingIndicator");

        const getPreferences = () => ({
            budget: Number(document.getElementById("chatBudget").value) || 0,
            rooms: Number(document.getElementById("chatRooms").value) || 0,
            type: (document.getElementById("chatType").value || "").trim(),
            size: Number(document.getElementById("chatSize").value) || 0
        });

        const escapeHtml = (value) => {
            const div = document.createElement("div");
            div.innerText = value ?? "";
            return div.innerHTML;
        };

        const renderPropertyCard = (property) => {
            if (!property) return "";
            return `
                <div class="ai-recommended-card animate__animated animate__fadeIn">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-primary">RECOMENDADO</span>
                        <span class="fw-bold text-dark">#${escapeHtml(property.code)}</span>
                    </div>
                    <div class="mb-1"><strong>Precio:</strong> US$ ${Number(property.price).toLocaleString()}</div>
                    <div class="small text-muted">
                        <i class="bi bi-door-open me-1"></i>${property.rooms} Hab. |
                        <i class="bi bi-arrows-fullscreen me-1"></i>${property.size}m²
                    </div>
                    <hr class="my-2">
                    <div class="text-primary fw-bold small">${escapeHtml(property.type)}</div>
                </div>
            `;
        };

        const appendMessage = (content, fromUser, recommendedProperty) => {
            const messageDiv = document.createElement("div");
            messageDiv.className = `ai-msg ${fromUser ? "ai-msg-user" : "ai-msg-bot"}`;
            messageDiv.innerHTML = `${escapeHtml(content)}${fromUser ? "" : renderPropertyCard(recommendedProperty)}`;
            chatMessages.appendChild(messageDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        };

        const sendMessage = async () => {
            const message = (chatInput.value || "").trim();
            if (!message) return;

            appendMessage(message, true);
            chatInput.value = "";
            typingIndicator.classList.remove("d-none");
            chatSend.disabled = true;

            try {
                const response = await fetch("/chat", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        message,
                        preferences: getPreferences(),
                        properties
                    })
                });

                const data = await response.json();
                if (!response.ok) {
                    appendMessage(data?.message || "Lo siento, tuve un problema al procesar los datos.", false);
                    return;
                }

                appendMessage(data.reply || "He analizado tus preferencias.", false, data.recommendedProperty);
            } catch {
                appendMessage("Error de conexión con la red de IA.", false);
            } finally {
                typingIndicator.classList.add("d-none");
                chatSend.disabled = false;
                chatInput.focus();
            }
        };

        chatSend.addEventListener("click", sendMessage);
        chatInput.addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); sendMessage(); } });
    })();
</script>